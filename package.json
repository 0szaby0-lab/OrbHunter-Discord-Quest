{
  "name": "orbweaver",
  "version": "1.0.0",
  "description": "Orbweaver — weave through Discord quests at lightspeed. Slash-command bot with parallel completion, turbo mode, and orb prioritization.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --watch-path=src src/index.js",
    "deploy": "node src/deploy-commands.js",
    "upload-emojis": "node src/upload-emojis.js",
    "login": "node scripts/local-login.js"
  },
  "keywords": [
    "discord",
    "quests",
    "orbs",
    "automation",
    "bot"
  ],
  "author": "shrujan-sb",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "https-proxy-agent": "^9.1.0",
    "playwright-core": "^1.64.1",
    "qrcode": "^1.5.4",
    "socks-proxy-agent": "^10.1.0",
    "ws": "^8.22.0"
  }
}
